[Unit]
Description=SOC ML Indexer Bridge
After=network.target soc-ml-api.service
Requires=soc-ml-api.service

[Service]
Type=simple
WorkingDirectory=/opt/ml-engine
EnvironmentFile=-/opt/ml-engine/.env
Environment=PYTHONPATH=/opt/ml-engine
Environment=WAZUH_INDEXER_URL=https://127.0.0.1:9200
Environment=WAZUH_INDEXER_USER=admin
Environment=SOC_ML_API=http://127.0.0.1:8088
# WAZUH_INDEXER_PASSWORD must come from /opt/ml-engine/.env — never hardcode here
ExecStart=/opt/ml-engine/.venv/bin/python -m src.bridge --out /opt/ml-engine/logs/enrichment.jsonl --interval 20
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
