[Unit]
Description=SOC ML Scoring API
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/ml-engine
EnvironmentFile=-/opt/ml-engine/.env
Environment=PYTHONPATH=/opt/ml-engine
Environment=SOC_ML_MODEL=/opt/ml-engine/artifacts/model.joblib
Environment=SOC_ML_MODEL_MULTI=/opt/ml-engine/artifacts/model_multiclass.joblib
Environment=SOC_ML_ENRICHMENT=/opt/ml-engine/logs/enrichment.jsonl
Environment=SOC_ML_BLOCK_AUDIT=/opt/ml-engine/logs/block_audit.jsonl
Environment=SOC_ML_CIC_DIR=/opt/ml-engine/artifacts/cic
ExecStart=/opt/ml-engine/.venv/bin/uvicorn src.api:app --host 0.0.0.0 --port 8088
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
