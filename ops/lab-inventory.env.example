# Copy to lab-inventory.env and adjust. Do NOT commit real passwords.
# Source this file:  set -a; . ./ops/lab-inventory.env; set +a

LAB_SUBNET=192.168.221.0/24
LAB_IFACE_IDS=ens37
LAB_IFACE_KALI=eth1

KALI_IP=192.168.221.30
IDS_IP=192.168.221.136
SOC_IP=192.168.221.138
WIN_IP=192.168.221.135

# Versions matching the verified lab
SURICATA_VERSION=8.0.7
WAZUH_VERSION=4.14.9
WAZUH_AGENT_NAME=suricata-ids

# SOC paths
ML_ENGINE_ROOT=/opt/ml-engine
WAZUH_COMPOSE_DIR=/opt/wazuh-docker/single-node
REPO_URL=https://github.com/zakariaehajji/soc-lab.git

# ML / Indexer (set locally; never commit real values)
WAZUH_INDEXER_URL=https://127.0.0.1:9200
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASSWORD=CHANGE_ME
SOC_ML_API=http://127.0.0.1:8088
SOC_ML_PORT=8088

# SSH (from operator workstation)
SSH_KEY=~/.ssh/lab_ed25519
SSH_USER=root
